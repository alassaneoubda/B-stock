# ============================================================
# B-Stock — Variables d'environnement (MODÈLE)
# Copier ce fichier en `.env.local` et renseigner de VRAIES valeurs.
# NE JAMAIS committer `.env.local` ni aucun secret réel dans ce fichier.
# ============================================================

# ----- Base de données (Neon PostgreSQL) -----
# Format Neon + pg : ajouter uselibpqcompat=true pour éviter le warning SSL
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require&uselibpqcompat=true"

# ----- NextAuth (v5) -----
# Générer une valeur forte: `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET="change-me-with-a-strong-random-32-bytes-secret"
# URL publique de l'application (prod) / localhost en dev
NEXTAUTH_URL="http://localhost:3000"

# ----- Google OAuth -----
# Console: https://console.cloud.google.com/apis/credentials
# Type: "ID client OAuth" -> "Application Web"
# URI de redirection autorisé: {NEXTAUTH_URL}/api/auth/callback/google
#   ex (dev):  http://localhost:3000/api/auth/callback/google
#   ex (prod): https://votre-domaine.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ----- GeniusPay (https://pay.genius.ci) -----
GENIUSPAY_API_KEY="pk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx"
GENIUSPAY_API_SECRET="sk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Obligatoire pour sécuriser le webhook d'abonnement
GENIUSPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GENIUSPAY_BASE_URL="https://pay.genius.ci/api/v1/merchant"

# ----- Paiements Mobile Money des entreprises clientes -----
# Clé de chiffrement (AES-256-GCM) des identifiants GeniusPay saisis par chaque
# entreprise dans Paramètres > Paiements Mobile Money. 32 octets en base64 :
#   openssl rand -base64 32
# Sans cette variable, la fonctionnalité est refusée. NE JAMAIS la changer sans
# faire ressaisir les identifiants (les anciens chiffrés deviendraient illisibles).
PAYMENT_CREDENTIALS_KEY=""

# ----- Tâches planifiées -----
# Secret partagé avec le planificateur (Vercel Cron, GitHub Actions…), 32+ caractères.
# Appel : GET /api/cron/reconcile-payments  avec  Authorization: Bearer <CRON_SECRET>
#         GET /api/cron/reconcile-mobile-money (paiements Mobile Money des entreprises, toutes les 10-15 min)
CRON_SECRET="change-me-with-a-long-random-secret"

# ----- Limitation de débit (Upstash Redis, offre gratuite) -----
# Sans ces variables : limite en mémoire, par instance (insuffisant en production).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ----- Débogage NextAuth (jamais en production) -----
# AUTH_DEBUG="true"
